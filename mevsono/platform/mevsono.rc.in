// Icône de l'exécutable Windows et informations de version, visibles dans l'explorateur de fichiers.
#pragma code_page(65001)
1 ICON "@MEVSONO_ICO@"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Rémi MEVAERE"
      VALUE "FileDescription", "MeVSono : analyse spectrale des sons"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "mevsono"
      VALUE "LegalCopyright", "Copyright (C) Rémi MEVAERE ; licence MIT"
      VALUE "OriginalFilename", "mevsono.exe"
      VALUE "ProductName", "MeVSono"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
