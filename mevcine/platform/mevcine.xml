<?xml version="1.0" encoding="UTF-8"?>
<!-- Type des projets de MeVCine, installé dans share/mime/packages : un double clic les ouvre. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-mevcine">
    <comment>Projet MeVCine</comment>
    <comment xml:lang="en">MeVCine project</comment>
    <icon name="mevcine"/>
    <glob pattern="*.mevcine"/>
  </mime-type>
</mime-info>
